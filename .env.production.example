APP_NAME="Cool Air Solution"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://coolair.k2studioapp.com
APP_TIMEZONE=Asia/Yangon

# Create the first office administrator with php bin/console user:create.
APP_ALLOW_SETUP=false
APP_REQUIRE_HTTPS=true
SESSION_NAME=cool_air_production_session
SESSION_SECURE_COOKIE=true

# Only list actual reverse-proxy IP addresses supplied by your host, if needed.
# Never trust arbitrary forwarded headers from internet clients.
TRUSTED_PROXIES=

# Persistent and private; relative to the project root, not public/.
DB_PATH=storage/database/app.sqlite
